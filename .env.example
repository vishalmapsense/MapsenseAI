# ==============================================================================
# MapsenseAI — Environment Variables Example Template
# Duplicate this file as `.env.local` and replace the placeholder values.
# ==============================================================================

# ── Mapbox MCP Server (stdio) ─────────────────────────────────────────────────
# Absolute path to built index.js of mapbox-mcp-server on the host machine/container
MAPBOX_MCP_SCRIPT_PATH=/path/to/mapbox-mcp-server/mcp-server/dist/esm/index.js
# Secret token for Mapbox API and MCP access
MAPBOX_SECRET_TOKEN=sk.your_mapbox_secret_token_here

# ── Playg MCP Server & Backend API ────────────────────────────────────────────
# Absolute path to built index.js of playg-mcp-server
PLAYG_MCP_SCRIPT_PATH=/path/to/playg-mcp-server/build/index.js
# Base URL for the Playg REST/backend API
PLAYG_API_BASE=http://localhost:8000
# Redis connection URL for caching
PLAYG_REDIS_URL=redis://localhost:6379
# Bearer JWT token for authenticated requests to Playg backend
PLAYG_BEARER_TOKEN=your_playg_jwt_token_here
BEARER_TOKEN=your_playg_jwt_token_here

# ── Backend MCP Server (Optional / Future) ────────────────────────────────────
BACKEND_MCP_URL=http://localhost:4000
BACKEND_MCP_API_KEY=your_backend_api_key_here

# ── Google Gemini API Key for ADK ─────────────────────────────────────────────
# Server-side Gemini API key used by the ADK agents
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase Configuration (Client & Server) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ── CARTO Basemap API Key ─────────────────────────────────────────────────────
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here

# ── ADK Agent Session Storage ─────────────────────────────────────────────────
# SQLite database URI (or postgresql:// connection string)
ADK_SESSION_DB_URI=sqlite://mapsense_adk.sqlite

# ── Ollama Local Models (Optional) ────────────────────────────────────────────
NEXT_PUBLIC_OLLAMA_BASE_URL=http://localhost:11434
